{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-D", "VCPKG_TARGET_TRIPLET=x64-windows-static",
                "-D", "CMAKE_TOOLCHAIN_FILE=${workspaceFolder}/vcpkglib/vcpkg.windows/scripts/buildsystems/vcpkg.cmake",
                "-G", "Visual Studio 17 2022",
                "-A", "x64",
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "Debug",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "Release",
                "--parallel"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Compile Shaders",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/shaders/glsl/compileshaders.py"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
