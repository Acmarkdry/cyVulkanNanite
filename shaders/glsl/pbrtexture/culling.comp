#version 450
#extension GL_GOOGLE_include_directive : enable

#include "data_structures.glsl"
#include "common_culling.glsl"

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

//=============================================================================
// Buffer Bindings
//=============================================================================

layout(std430, set = 0, binding = 0) buffer readonly ClustersIn {
    Cluster indata[];
};

layout(std430, set = 0, binding = 1) buffer readonly TrianglesIn {
    uint inTriangles[];
};

layout(std430, set = 0, binding = 2) buffer writeonly TrianglesOut_hw {
    uint outTriangles_hw[];
};

layout(std430, set = 0, binding = 3) buffer NumVertices_hw {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    uint vertexOffset;
    uint firstInstance;
} numVertices_hw;

layout(set = 0, binding = 4) uniform UBOMats {
    mat4 model;     // unused
    mat4 lastView;
    mat4 lastProj;
    mat4 currView;
    mat4 currProj;
} ubomats;

layout(set = 0, binding = 5) uniform sampler2D lastHZB;

layout(std430, set = 0, binding = 6) buffer readonly ProjectedError {
    vec2 errorData[];
};

layout(std430, set = 0, binding = 7) buffer writeonly IdOut_hw {
    uvec3 outIds_hw[];
};

layout(std430, set = 0, binding = 8) buffer writeonly TrianglesOut_sw {
    uint outTriangles_sw[];
};

layout(std430, set = 0, binding = 9) buffer writeonly IdOut_sw {
    uvec3 outIds_sw[];
};

layout(std430, set = 0, binding = 10) buffer NumVertices_sw {
    uint indexCount;
} numVertices_sw;

layout(set = 0, binding = 11) buffer ClusterIndices {
    uint culledClusterSize;
    uint frustumCullingNum;
    uint occulusionCullingNum;
    uint errorCullingNum;
    uint culledClusterIndices[];
} culledClusters;

layout(set = 0, binding = 12) buffer clusterObjectIndexBuffer {
    uint clusterObjectIndices[];
};

layout(set = 0, binding = 13) buffer readonly ModelMatIn {
    mat4 inModelMats[];
};

layout(push_constant) uniform PushConstants {
    int  numClusters;
    float threshold;
    int  useFrustrumOcclusion;
    int  useSoftwareRast;
} pcs;

//=============================================================================
// 三角形输出辅助函数
//=============================================================================

void emitTriangles(uint clusterIndex, uint objectId, uint localIdx, bool useSWR)
{
    Cluster c = indata[clusterIndex];
    uint totalVertices = (c.triangleEnd - c.triangleStart) * 3u;

    for (uint i = 0u; i < totalVertices / 3u; i++)
    {
        uint inIdx  = c.triangleStart * 3u + 3u * i;
        uint outIdx = localIdx + 3u * i;

        if (!useSWR)
        {
            outTriangles_hw[outIdx + 0u] = inTriangles[inIdx + 0u];
            outTriangles_hw[outIdx + 1u] = inTriangles[inIdx + 1u];
            outTriangles_hw[outIdx + 2u] = inTriangles[inIdx + 2u];
            outIds_hw[outIdx / 3u] = uvec3(objectId, clusterIndex, i);
        }
        else
        {
            outTriangles_sw[outIdx + 0u] = inTriangles[inIdx + 0u];
            outTriangles_sw[outIdx + 1u] = inTriangles[inIdx + 1u];
            outTriangles_sw[outIdx + 2u] = inTriangles[inIdx + 2u];
            outIds_sw[outIdx / 3u] = uvec3(objectId, clusterIndex, i);
        }
    }
}

//=============================================================================
// Main
//=============================================================================

void main()
{
    if (gl_GlobalInvocationID.x >= culledClusters.culledClusterSize) return;

    uint clusterIndex = culledClusters.culledClusterIndices[gl_GlobalInvocationID.x];
    uint objectId     = clusterObjectIndices[gl_GlobalInvocationID.x];

    Cluster currCluster = indata[clusterIndex];

    // 变换到世界空间
    currCluster.pMin = vec3(inModelMats[objectId] * vec4(currCluster.pMin, 1.0));
    currCluster.pMax = vec3(inModelMats[objectId] * vec4(currCluster.pMax, 1.0));

    // 预计算 VP 矩阵
    mat4 currVP = ubomats.currProj * ubomats.currView;
    mat4 lastVP = ubomats.lastProj * ubomats.lastView;

    bool culled = false;
    float pixelArea = 0.0;

    if (pcs.useFrustrumOcclusion == 1)
    {
        culled = culled || frustumCulling(currCluster.pMin, currCluster.pMax, currVP);
        culled = culled || occlusionCulling(currCluster.pMin, currCluster.pMax, lastVP,
                                            lastHZB, pixelArea);
    }
    else
    {
        // 仅计算 pixelArea 用于 SW/HW 分流
        vec4 clipXY;
        float minZ;
        getScreenAABB(currCluster.pMin, currCluster.pMax, lastVP, clipXY, minZ);
        vec4 screenSize = textureSize(lastHZB, 0).xyxy;
        vec4 screenXY   = clipXY * screenSize;
        vec2 screenSpan = screenXY.zw - screenXY.xy;
        pixelArea = screenSpan.x * screenSpan.y;
    }

    // SW/HW 光栅化分流
    bool useSWR = (pcs.useSoftwareRast == 1) ? (pixelArea < 256.0) : false;

    // 误差剔除 (LOD)
    // BVH traversal 的 errorCulling 使用保守估计，保证两级不会矛盾
    culled = culled || (errorData[gl_GlobalInvocationID.x].y <= pcs.threshold
                     || errorData[gl_GlobalInvocationID.x].x > pcs.threshold);

    // 分配输出空间
    uint totalVertices = culled ? 0u : (indata[clusterIndex].triangleEnd - indata[clusterIndex].triangleStart) * 3u;
    uint localIdx;
    if (!useSWR)
        localIdx = atomicAdd(numVertices_hw.indexCount, totalVertices);
    else
        localIdx = atomicAdd(numVertices_sw.indexCount, totalVertices);

    // 输出三角形数据
    if (!culled)
    {
        emitTriangles(clusterIndex, objectId, localIdx, useSWR);
    }
}
