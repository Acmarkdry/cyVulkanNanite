/*
 * error.comp
 * 逐 Cluster 屏幕空间误差计算着色器 — Nanite 风格渲染管线
 *
 * 将每个 cluster 的世界空间误差投影到屏幕空间，
 * 输出 (selfError, parentError) 用于后续 LOD 选择剔除
 */

#version 450
#extension GL_GOOGLE_include_directive : enable

#include "data_structures.glsl"
#include "common_culling.glsl"

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

//=============================================================================
// Buffer Bindings
//=============================================================================

layout(std430, set = 0, binding = 0) buffer readonly WorldError {
    ErrorInfo idata[];
};

layout(std430, set = 0, binding = 1) buffer ClusterError {
    vec2 odata[];
};

layout(set = 0, binding = 2) uniform UBOMats {
    mat4 view;
    mat4 proj;
    vec3 camUp;
    vec3 camRight;
} ubomats;

layout(set = 0, binding = 3) buffer ClusterIndices {
    uint culledClusterSize;
    uint frustumCullingNum;
    uint occulusionCullingNum;
    uint errorCullingNum;
    uint culledClusterIndices[];
} culledClusters;

layout(set = 0, binding = 4) buffer clusterObjectIndexBuffer {
    uint clusterObjectIndices[];
};

layout(set = 0, binding = 5) buffer readonly ModelMatIn {
    mat4 inModelMats[];
};

layout(push_constant) uniform PushConstants {
    int  numClusters;
    vec2 screenSize;
} pcs;

//=============================================================================
// Main
//=============================================================================

void main()
{
    if (gl_GlobalInvocationID.x >= culledClusters.culledClusterSize) return;

    uint clusterIndex = culledClusters.culledClusterIndices[gl_GlobalInvocationID.x];
    uint objectId     = clusterObjectIndices[gl_GlobalInvocationID.x];

    ErrorInfo error = idata[clusterIndex];
    mat4 vp = ubomats.proj * ubomats.view;

    // 节点自身误差 → 屏幕空间
    vec3  centerSelf = (inModelMats[objectId] * vec4(error.centerR.xyz, 1.0)).xyz;
    float radiusSelf = length(inModelMats[objectId] * vec4(error.centerR.w, 0.0, 0.0, 0.0));
    odata[gl_GlobalInvocationID.x].x = error.errorWorld.x *
        getScreenBoundRadiusSq(centerSelf, radiusSelf,
                               vp, ubomats.camUp, ubomats.camRight, pcs.screenSize);

    // 父节点误差 → 屏幕空间
    vec3  centerParent = (inModelMats[objectId] * vec4(error.centerRP.xyz, 1.0)).xyz;
    float radiusParent = length(inModelMats[objectId] * vec4(error.centerRP.w, 0.0, 0.0, 0.0));
    odata[gl_GlobalInvocationID.x].y = error.errorWorld.y *
        getScreenBoundRadiusSq(centerParent, radiusParent,
                               vp, ubomats.camUp, ubomats.camRight, pcs.screenSize);
}
