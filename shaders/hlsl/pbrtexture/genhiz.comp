

#define WORKGROUP_SIZE 8

// set = 0, binding = 0, r32f, storage image (readonly in logic)
[[vk::binding(0, 0)]]
[[vk::image_format("r32f")]]
RWTexture2D<float> iImage;  // 使用 RWTexture2D 生成 STORAGE_IMAGE

// set = 0, binding = 1, r32f, storage image
[[vk::binding(1, 0)]]
[[vk::image_format("r32f")]]
RWTexture2D<float> oImage;

[numthreads(WORKGROUP_SIZE, WORKGROUP_SIZE, 1)]
void main(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int2 index = int2(dispatchThreadID.xy);
    
    uint inputWidth, inputHeight;
    iImage.GetDimensions(inputWidth, inputHeight);
    
    uint outputWidth, outputHeight;
    oImage.GetDimensions(outputWidth, outputHeight);
    
    if (index.x >= (int)outputWidth || index.y >= (int)outputHeight)
        return;
    
    float depth = 0.0f;
    int2 inputCoord = index * 2;
    
    // RWTexture2D 使用 [] 操作符读取
    // depth = max(depth, iImage[inputCoord]);
    // depth = max(depth, iImage[inputCoord + int2(0, 1)]);
    // depth = max(depth, iImage[inputCoord + int2(1, 0)]);
    // depth = max(depth, iImage[inputCoord + int2(1, 1)]);
    
    oImage[index] = depth;
}
